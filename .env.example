# ==============================================================================
#                      CONFIGURACAO DE AMBIENTE - DUQUE IA
# ==============================================================================

# ---- SERVIDOR WEB E GATEWAY HTTP ---------------------------------------------
PORT=3000
MAX_WORKERS=4
ADMIN_API_KEY=sua-chave-admin-secreta-aqui
ADMIN_USERNAME=admin
ADMIN_PASSWORD=duqueia2026

# ---- GEMINI API (Google AI Studio / Vertex AI) --------------------------------
# Chaves válidas: aceita chaves do AI Studio ("AIzaSy...") e tokens de serviço ("AQ.Ab8RN...")
# Pode informar múltiplas chaves separadas por vírgula para rotação e alta disponibilidade
GEMINI_API_KEYS=AQ.Ab8RN_chave_primaria_aqui,AIzaSy_chave_backup_aqui

# Modelos Cognitivos Oficiais
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Camada de triagem inteligente (triage layer)
USE_TRIAGE_LAYER=true

# ---- GROQ API (LLaMA Alternativo Ultra-rápido) -------------------------------
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant
GROQ_QUALITY_MODEL=llama-3.3-70b-versatile

# ---- BANCO DE DADOS SUPABASE (PGVector - Opcional) ---------------------------
SUPABASE_URL=https://sua-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ---- CONFIGURACOES GERAIS DO SISTEMA -----------------------------------------
ENVIRONMENT=production
LOG_LEVEL=info
