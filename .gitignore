# ==============================================================================
#                      .gitignore - DUQUE IA
# ==============================================================================

# Dependências e Pacotes
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Ambiente Virtual e Cache Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# Segredos, Chaves de API e Configurações Locais
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.agents/
scratch/

# Banco de Dados SQLite Local (Bancos da aplicação inclusos no repositório)
*.db
*.db-journal
*.db-wal
*.db-shm
*.bak
*.zip
!data/db/main.db
!data/db/vector.db
!data/db/cache.db
!data/db/telemetry.db
data/backups/
archive/database_backups/
backup-local-*/

# Logs e Métricas Locais
logs/
metrics/*.jsonl
metrics/telemetry/
*.log

# Arquivos de Áudio e Uploads de Usuários (Chat de Voz)
public/audio/*.wav
public/audio/*.mp3
public/audio/*.webm
public/audio/*.ogg
!public/audio/.gitkeep
public/uploads/*
!public/uploads/.gitkeep

# Dossiês e Relatórios Pesados Gerados Localmente
*.pdf
*.docx
!data/knowledge/OFICIOS/*.pdf
!data/raw/raw_pdf_files/*.pdf
docs/audio_demonstracao/
docs/apresentacao_executiva_a4/
data/resultados_todas_as_perguntas.json
data/todas_as_perguntas_consolidadas.json
scripts/results_*.json
player_audio_respostas.html

# Arquivos Temporários de Escritório e Sistema
~$*
~$*.docx
~$*.xlsx
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
